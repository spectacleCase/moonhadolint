name = "spectacleCase/moonhadolint"

version = "0.1.2"

readme = "README.mbt.md"

repository = "https://github.com/spectacleCase/moonhadolint.git"

license = "Apache-2.0"

keywords = [ "dockerfile", "hadolint", "lint", "docker", "parser", "cli" ]

preferred_target = "native"

description = "Dockerfile parser and hadolint-style linter for MoonBit"
